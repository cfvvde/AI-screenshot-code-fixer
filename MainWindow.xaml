<Window x:Class="SharpLensAI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SharpLens AI" Width="1060" Height="720" MinWidth="800" MinHeight="580" WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="HistoryButton" Content="История" Click="HistoryButton_Click"/><Button x:Name="SettingsButton" Content="Настройки" Click="SettingsButton_Click"/></StackPanel>
   <StackPanel><TextBlock Text="SharpLens AI" FontSize="28" FontWeight="Bold" Foreground="#172B4D"/><TextBlock Text="Выделите область → проверьте текст → задайте вопрос" Foreground="#607086"/></StackPanel>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,14">
   <Button x:Name="CaptureButton" Content="Захватить область" Click="CaptureButton_Click" Background="#245CDD" Foreground="White"/>
   <ComboBox x:Name="LanguageBox" SelectedIndex="0" Width="150" Margin="8,0" VerticalContentAlignment="Center"><ComboBoxItem Content="Авто · RU + EN"/><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox>
   <TextBlock x:Name="HotkeyLabel" VerticalAlignment="Center" Foreground="#607086"/>
  </DockPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <GroupBox Header="1. Текст для обработки" Background="White" Padding="10"><TextBox x:Name="OcrResultTextBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"/></GroupBox>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#D8E0ED"/>
   <GroupBox Grid.Column="2" Header="2. Ответ ИИ" Background="White" Padding="10"><DockPanel><Button DockPanel.Dock="Bottom" Content="Скопировать ответ" Click="CopyButton_Click" HorizontalAlignment="Right"/><FlowDocumentScrollViewer x:Name="AnswerViewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/></DockPanel></GroupBox>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,16,0,0">
   <TextBlock Text="Инструкция для ИИ" Foreground="#607086" Margin="0,0,0,6"/>
   <DockPanel><Button x:Name="AskAiButton" DockPanel.Dock="Right" Content="Обработать текст" Click="AskAiButton_Click" Background="#245CDD" Foreground="White"/><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Отменить" Click="CancelButton_Click" IsEnabled="False"/><ComboBox x:Name="AiTaskComboBox" VerticalContentAlignment="Center" SelectionChanged="AiTaskComboBox_SelectionChanged"/></DockPanel>
   <TextBox x:Name="CustomPromptTextBox" Visibility="Collapsed" AcceptsReturn="True" Height="65" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" ToolTip="Введите свой вопрос или инструкцию"/>
   <TextBlock Text="В ИИ отправляются только текст слева и выбранная инструкция — после нажатия кнопки." FontSize="12" Foreground="#607086" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Готово к работе" TextWrapping="Wrap" Foreground="#365476" Margin="0,6,0,0"/></StackPanel>
 </Grid>
</Window>
