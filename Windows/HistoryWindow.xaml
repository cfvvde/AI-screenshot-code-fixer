<Window x:Class="SharpLensAI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История запросов — SharpLens AI"
        Width="940" Height="620" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F8FA"
        FontFamily="Segoe UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Text="История запросов" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Открыть запрос" Click="Open_Click"/><Button DockPanel.Dock="Right" Content="Скопировать ответ" Click="Copy_Click"/><Button DockPanel.Dock="Right" Content="Очистить историю" Padding="12,7" Click="ClearHistory_Click"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="HistoryList" Grid.Column="0" SelectionChanged="HistoryList_SelectionChanged"
                     BorderBrush="#FFE2E8F0" Background="White" Padding="4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5,7">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Summary}" Foreground="#FF64748B" FontSize="11"
                                       TextWrapping="Wrap" MaxHeight="40" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="110"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Распознанный текст" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="RecognizedTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True" BorderBrush="#FFE2E8F0" Background="White" Padding="8"/>
                <TextBox x:Name="InstructionBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" ToolTip="Инструкция и модель"/><TextBlock Grid.Row="3" Text="Ответ ИИ" FontWeight="SemiBold" Margin="0,12,0,5"/>
                <Border Grid.Row="4" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" Padding="4">

                        <FlowDocumentScrollViewer x:Name="HistoryAnswerViewer" IsToolBarVisible="False"/>

                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
