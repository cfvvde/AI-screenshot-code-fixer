<Window x:Class="SharpLensAI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки API" Height="180" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock Text="Свой Gemini API Ключ (необязательно):" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Name="ApiKeyTextBox" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
        <TextBlock Text="Оставьте пустым, чтобы использовать стандартный ключ." Foreground="Gray" Margin="0,5,0,0" FontSize="11"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="90" Height="30" Click="SaveButton_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>